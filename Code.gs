const OWNER_EMAIL = 'hello@minhanh.dev';
function doPost(e) { const data = e && e.parameter ? e.parameter : {}; const name = sanitize_(data.name); const email = sanitize_(data.email); const message = sanitize_(data.message); if (!name || !email || !message) return jsonResponse_({ success: false, error: 'Vui lòng điền đầy đủ thông tin.' }); const safeName = escapeHtml_(name); const safeMessage = escapeHtml_(message).replace(/\n/g, '<br>'); const htmlBody = `<div style="font-family:Arial,sans-serif;max-width:600px;margin:auto;color:#172525;line-height:1.6"><div style="background:#172525;padding:28px;color:#f5f0e8"><span style="font-size:28px;font-weight:bold">ma<span style="color:#f06449">.</span></span></div><div style="padding:32px;background:#f5f0e8"><p style="color:#f06449;text-transform:uppercase;font-size:12px;letter-spacing:2px">Cảm ơn bạn đã liên hệ</p><h1 style="font-size:30px;margin:10px 0 20px">Chào ${safeName},</h1><p>Mình đã nhận được lời nhắn và sẽ phản hồi bạn sớm nhất có thể.</p><div style="border-left:4px solid #f06449;padding:12px 18px;margin:24px 0;background:#fff">${safeMessage}</div><p>Thân mến,<br><strong>Minh Anh</strong></p></div></div>`; MailApp.sendEmail({ to: email, subject: 'Minh Anh đã nhận được lời nhắn của bạn', htmlBody }); MailApp.sendEmail({ to: OWNER_EMAIL, replyTo: email, subject: `Liên hệ mới từ ${name}`, htmlBody: `<p><strong>${safeName}</strong> (${escapeHtml_(email)}) vừa gửi:</p><p>${safeMessage}</p>` }); return jsonResponse_({ success: true }); }
function sanitize_(value) { return String(value || '').trim().slice(0, 5000); }
function escapeHtml_(value) { return value.replace(/[&<>"']/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' })[char]); }
function jsonResponse_(payload) { return ContentService.createTextOutput(JSON.stringify(payload)).setMimeType(ContentService.MimeType.JSON); }